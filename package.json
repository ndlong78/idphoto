{
  "name": "idphoto-mvp",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "test:watch": "node --test --watch tests/*.test.js",
    "test:coverage": "node --experimental-test-coverage --test tests/*.test.js",
    "test:e2e": "playwright test",
    "test:e2e:desktop": "playwright test --project=chromium-desktop",
    "test:e2e:mobile": "playwright test --project=chromium-mobile",
    "test:e2e:journey": "playwright test e2e/upload-export-journey.desktop.spec.js --project=chromium-desktop",
    "lint": "eslint src/ tests/ e2e/ scripts/ playwright.config.js",
    "lint:fix": "eslint src/ tests/ e2e/ scripts/ playwright.config.js --fix"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.1.0",
    "globals": "^17.4.0"
  }
}
